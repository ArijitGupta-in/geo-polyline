{
    "name": "@arijitgupta/geo-polyline",
    "version": "1.0.0",
    "description": "Validate and manipulate geographic polylines with length, segment, deduplication, merge, and mapping operations.",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/ArijitGupta-in/geo-polyline.git"
    },
    "homepage": "https://github.com/ArijitGupta-in/geo-polyline",
    "bugs": {
        "url": "https://github.com/ArijitGupta-in/geo-polyline/issues"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "sideEffects": false,
    "scripts": {
        "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "build": "npm run clean && tsc",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
        "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
        "prepublishOnly": "npm run check && npm run test:coverage && npm run build"
    },
    "keywords": [
        "geo",
        "geospatial",
        "polyline",
        "path",
        "coordinates",
        "DMS",
        "latitude",
        "longitude",
        "geography",
        "great-circle",
        "distance",
        "kilometers",
        "miles",
        "feet",
        "nautical-miles",
        "track",
        "route"
    ],
    "author": "Arijit Gupta",
    "license": "MIT",
    "devDependencies": {
        "@vitest/coverage-v8": "^4.1.11",
        "markdownlint-cli2": "^0.23.2",
        "typescript": "^7.0.2",
        "vitest": "^4.1.11"
    },
    "dependencies": {
        "@arijitgupta/geo-core": "^1.1.0",
        "@arijitgupta/geo-distance": "^2.1.0"
    }
}
