{
    "name": "@arijitgupta/geo-polyline",
    "version": "0.1.0",
    "description": "Utilities for working with ordered geographic coordinate paths and polylines.",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/ArijitGupta-in/geo-polyline.git"
    },
    "homepage": "https://github.com/ArijitGupta-in/geo-polyline",
    "bugs": {
        "url": "https://github.com/ArijitGupta-in/geo-polyline/issues"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
        "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
        "prepublishOnly": "npm run check && npm run test:coverage && npm run build"
    },
    "keywords": [
        "geo",
        "geospatial",
        "polyline",
        "path",
        "coordinates",
        "track",
        "route",
        "geography"
    ],
    "author": "Arijit Gupta",
    "license": "MIT",
    "dependencies": {
        "@arijitgupta/geo-core": "^1.0.0"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "^4.1.11",
        "markdownlint-cli2": "^0.23.2",
        "typescript": "^7.0.2",
        "vitest": "^4.1.11"
    }
}
